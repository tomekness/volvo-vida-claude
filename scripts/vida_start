#!/usr/bin/env bash
# Startet die VIDA VM und öffnet eine RDP-Verbindung.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/config.sh" 2>/dev/null || { echo "FEHLER: scripts/config.sh fehlt"; exit 1; }
source "$SCRIPT_DIR/lib.sh"

echo "→ Prüfe VM-Status..."
STATE=$(run_cmd "VBoxManage showvminfo '$VM_NAME' --machinereadable | grep '^VMState='" 2>/dev/null)

if echo "$STATE" | grep -q "running"; then
  echo "→ VM läuft bereits."
else
  echo "→ Starte $VM_NAME headless..."
  run_cmd "VBoxManage startvm '$VM_NAME' --type headless"
  echo "→ Warte bis Windows hochgefahren ist (~90 Sekunden)..."
  sleep 90
fi

RDP_TARGET="${RDP_HOST:-localhost:3389}"
echo "→ Öffne RDP-Verbindung zu $RDP_TARGET ..."
if command -v remmina &>/dev/null; then
  remmina rdp://$RDP_TARGET &
elif command -v xfreerdp &>/dev/null; then
  xfreerdp /v:$RDP_TARGET /size:1152x863 &
else
  echo "! Kein RDP-Client gefunden — bitte installieren: sudo apt install remmina"
  echo "  Dann manuell verbinden: remmina rdp://$RDP_TARGET"
fi

echo "✓ Fertig. Login: vida / vida"
