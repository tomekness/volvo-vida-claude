#!/usr/bin/env bash
# VIDA Claude Skills — Configuration
# Copy this file: cp scripts/config.sh.example scripts/config.sh
# Then fill in your values. config.sh is NOT committed to git.

# ── Agent mode ────────────────────────────────────────────────────────────────
# "local" = Agent and VirtualBox run on the same machine (no SSH needed)
# "ssh"   = VIDA runs on a remote host; agent connects via SSH
AGENT_MODE="ssh"

# ── SSH access to the host machine (only used when AGENT_MODE=ssh) ────────────
SSH_HOST="192.168.1.100"           # IP or hostname of the machine running VirtualBox
SSH_PORT="22"                      # SSH port (default: 22)
SSH_USER="username"                # SSH username on the host
SSH_KEY="$HOME/.ssh/id_ed25519"    # SSH private key

# ── VirtualBox VM ─────────────────────────────────────────────────────────────
VM_NAME="VIDA 2014D"               # Exact VM name as shown in VirtualBox
RDP_HOST="192.168.1.100:3389"      # RDP address (IP:port)
SQL_PORT_NAT="14333"               # NAT port → 1433 inside VM (for VIDA SQL queries)

# ── Paths on the host machine ─────────────────────────────────────────────────
# Desktop directory — depends on the OS locale:
HOST_DESKTOP="~/Desktop"                     # English Ubuntu/Debian
# HOST_DESKTOP="~/Schreibtisch"              # German Ubuntu
HOST_DOWNLOADS="~/Downloads"                 # Same on all locales
HOST_PICTURES="~/Pictures/Screenshots"       # English Ubuntu
# HOST_PICTURES="~/Bilder/Bildschirmfotos"   # German Ubuntu

REMOTE_REPO_PATH="$HOST_DESKTOP/volvo-vida-claude"
REMOTE_DOWNLOADS_PATH="$HOST_DOWNLOADS"      # Mounted as Z:\ inside the VM
REMOTE_SCREENSHOTS_PATH="$HOST_PICTURES"

# ── VIDA Web UI (SSH tunnel for vida_connect) ─────────────────────────────────
VIDA_WEB_PORT="8080"               # Port on the host → VM:80 (after JBoss 0.0.0.0 patch)
VIDA_LOCAL_PORT="18080"            # Local port for the SSH tunnel (vida_connect)

# ── Snapshots ─────────────────────────────────────────────────────────────────
DEFAULT_SNAPSHOT=""                # Default for vida_reset — e.g. "baseline-de"

# ── Vehicle info (for VIDA database queries) ───────────────────────────────────
VIN="YOUR_VIN_HERE"
VIDA_VEHICLE_MODEL="1005"   # fkVehicleModel: 1005 = Volvo V70 II (P2, 2000-2007) — example
VIDA_MODEL_YEAR="1188"      # fkModelYear:    1188 = model year 2002 — example
# Find IDs for your vehicle via /vida_init, or manually:
#   sqlcmd -S .\VIDA -d servicerep_${VIDA_LANGUAGE} -Q "SELECT Id, Name FROM VehicleModel ORDER BY Name"
#   sqlcmd -S .\VIDA -d servicerep_${VIDA_LANGUAGE} -Q "SELECT Id, Name FROM ModelYear ORDER BY Name"

# ── VIDA language ─────────────────────────────────────────────────────────────
# Controls which servicerep database is queried: servicerep_de-DE, servicerep_en-US, etc.
# Must match the language installed via the Language Switcher on the VM desktop.
VIDA_LANGUAGE="de-DE"

# ── vida_docs.db (VIDA document database, ~230 MB, not in git) ────────────────
# 0 = DB on SSH host (diagnostics machine), queried via SSH
# 1 = DB local on this machine, direct query (faster, no SSH needed)
VIDA_DOCS_LOCAL=0
VIDA_DOCS_DB_PATH="$HOST_DESKTOP/vida_docs.db"
