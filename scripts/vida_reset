#!/usr/bin/env bash
# Setzt die VIDA VM auf einen Snapshot zurück.
# Usage: vida_reset [snapshot-name]
# Default: letzter bekannter guter Snapshot (in config.sh als DEFAULT_SNAPSHOT)
# --list  Zeigt alle verfügbaren Snapshots an
#
# Snapshot nehmen (nicht nur wiederherstellen): scripts/vida_snapshot

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/config.sh" 2>/dev/null || { echo "FEHLER: scripts/config.sh fehlt"; exit 1; }
source "$SCRIPT_DIR/lib.sh"

if [ "$1" = "--list" ]; then
  echo "→ Verfügbare Snapshots:"
  run_cmd "VBoxManage snapshot '$VM_NAME' list" 2>/dev/null
  exit 0
fi

SNAPSHOT="${1:-${DEFAULT_SNAPSHOT:-}}"
if [ -z "$SNAPSHOT" ]; then
  echo "FEHLER: Kein Snapshot angegeben und DEFAULT_SNAPSHOT nicht in config.sh gesetzt."
  echo "Usage: vida_reset <snapshot-name>"
  echo "       vida_reset --list"
  exit 1
fi

echo "→ Snapshot-Reset: '$SNAPSHOT'"

echo "→ Prüfe VM-Status..."
STATE=$(run_cmd "VBoxManage showvminfo '$VM_NAME' --machinereadable | grep '^VMState='" 2>/dev/null)

if ! echo "$STATE" | grep -qE "poweroff|aborted|saved"; then
  echo "→ VM läuft noch — poweroff (hart, für Reset OK)..."
  run_cmd "VBoxManage controlvm '$VM_NAME' poweroff" 2>/dev/null
  sleep 5
fi

echo "→ Stelle Snapshot wieder her..."
if run_cmd "VBoxManage snapshot '$VM_NAME' restore '$SNAPSHOT'" 2>&1; then
  echo "✓ Snapshot '$SNAPSHOT' wiederhergestellt."
else
  echo "! Fehler — verfügbare Snapshots:"
  run_cmd "VBoxManage snapshot '$VM_NAME' list" 2>/dev/null
  exit 1
fi

echo "→ Starte VM headless..."
run_cmd "VBoxManage startvm '$VM_NAME' --type headless" 2>/dev/null
sleep 3
RDP_TARGET="${RDP_HOST:-localhost:3389}"
echo "✓ VM gestartet. RDP: $RDP_TARGET — Login: vida / vida"
