#!/usr/bin/env bash
# Zeigt Status der VIDA VM und des Host-Rechners

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/config.sh" 2>/dev/null || { echo "FEHLER: scripts/config.sh fehlt"; exit 1; }
source "$SCRIPT_DIR/lib.sh"

if [ "${AGENT_MODE:-ssh}" = "local" ]; then
  echo "=== Lokaler Rechner ==="
  echo -n "RAM: "
  free -h | awk 'NR==2{print $2" gesamt, "$7" verfügbar"}'
  echo -n "Disk: "
  df -h "$HOME" | awk 'NR==2{print $4" frei ("$5" benutzt)"}'
else
  echo "=== Host-Rechner ($SSH_HOST) ==="
  run_cmd "echo 'RAM:' && free -h | awk 'NR==2{print \$2\" gesamt, \"\$7\" verfügbar\"}' && echo 'Disk:' && df -h /home | awk 'NR==2{print \$4\" frei (\"\$5\" benutzt)\"}'"
fi

echo ""
echo "=== VIDA VM ($VM_NAME) ==="
run_cmd "VBoxManage showvminfo '$VM_NAME' | grep -E '^State|Memory size|Number of CPUs|VRDE port'"

echo ""
echo "=== RDP-Zugang ==="
RDP_TARGET="${RDP_HOST:-localhost:3389}"
RDP_PORT="${RDP_TARGET##*:}"
RDP_STATE=$(run_cmd "ss -tn | grep $RDP_PORT | head -1" 2>/dev/null)
if [ -n "$RDP_STATE" ]; then
  echo "Aktive RDP-Verbindung: $RDP_STATE"
else
  echo "Kein aktiver RDP-Client verbunden"
fi
echo "Verbinden: remmina rdp://$RDP_TARGET"
