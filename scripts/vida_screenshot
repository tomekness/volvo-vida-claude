#!/usr/bin/env bash
# Macht einen Screenshot der VIDA VM und öffnet ihn lokal

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/config.sh" 2>/dev/null || { echo "FEHLER: scripts/config.sh fehlt"; exit 1; }

TMP="/tmp/vida_screenshot_$(date +%H%M%S).png"

ssh -i "$SSH_KEY" -p "$SSH_PORT" -o StrictHostKeyChecking=no "$SSH_USER@$SSH_HOST" \
  "vboxmanage controlvm '$VM_NAME' screenshotpng /tmp/vida_shot.png" 2>/dev/null

scp -i "$SSH_KEY" -P "$SSH_PORT" "$SSH_USER@$SSH_HOST:/tmp/vida_shot.png" "$TMP" 2>/dev/null

if [ -f "$TMP" ]; then
  echo "→ Screenshot: $TMP"
  xdg-open "$TMP" 2>/dev/null || eog "$TMP" 2>/dev/null || echo "Öffne manuell: $TMP"
else
  echo "! Screenshot fehlgeschlagen — läuft die VM?"
fi
