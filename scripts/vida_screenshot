#!/usr/bin/env bash
# Macht einen Screenshot der VIDA VM und öffnet ihn lokal

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/config.sh" 2>/dev/null || { echo "FEHLER: scripts/config.sh fehlt"; exit 1; }
source "$SCRIPT_DIR/lib.sh"

TMP="/tmp/vida_screenshot_$(date +%H%M%S).png"

if [ "${AGENT_MODE:-ssh}" = "local" ]; then
  VBoxManage controlvm "$VM_NAME" screenshotpng "$TMP" 2>/dev/null
else
  run_cmd "VBoxManage controlvm '$VM_NAME' screenshotpng /tmp/vida_shot.png" 2>/dev/null
  get_remote_file "/tmp/vida_shot.png" "$TMP"
fi

if [ -f "$TMP" ]; then
  echo "→ Screenshot: $TMP"
  xdg-open "$TMP" 2>/dev/null || eog "$TMP" 2>/dev/null || echo "Öffne manuell: $TMP"
else
  echo "! Screenshot fehlgeschlagen — läuft die VM?"
fi
