#!/usr/bin/env bash
# Syncs the diagnostics host machine with the central git repo.
# In ssh mode:  commits+pushes on the remote host, then pulls locally.
# In local mode: commits+pushes locally (no remote host involved).
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
source "$REPO/scripts/config.sh"
source "$REPO/scripts/lib.sh"

if [ "${AGENT_MODE:-ssh}" = "local" ]; then
  echo "→ Local mode: committing and pushing..."
  cd "$REPO"
  if [ -n "$(git status --porcelain)" ]; then
    git add -A
    MSG="Update: $(date '+%Y-%m-%d %H:%M')"
    git commit -m "$MSG"
    echo "→ Committed: $MSG"
    git push
    echo "→ Pushed."
  else
    echo "→ Nothing to commit."
  fi
  echo "✓ Sync complete."
  exit 0
fi

REMOTE_PATH="$REMOTE_REPO_PATH"

echo "→ Host: checking for new files..."
ssh -i "$SSH_KEY" -p "$SSH_PORT" -o StrictHostKeyChecking=no "$SSH_USER@$SSH_HOST" bash << REMOTE
set -e
cd $REMOTE_PATH

if [ -n "\$(git status --porcelain)" ]; then
  git add -A
  MSG="Host Update: \$(date '+%Y-%m-%d %H:%M')"
  git commit -m "\$MSG"
  echo "→ Committed: \$MSG"
  git push
  echo "→ Pushed."
else
  echo "→ Host: nothing to commit."
fi

git pull
echo "✓ Host: pull done."
REMOTE

echo "→ Pulling locally..."
git -C "$REPO" pull
echo "✓ Sync complete."
